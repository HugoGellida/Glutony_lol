{
  "passes": [
    {
      "phase": "built-in/render_phase/geometry.render_phase",
      "shader": "built-in/shaders/camera_depth",
      "iterator": "none",
      "uniforms": [],
      "target": { "name": "scene_depth", "shared": true, "format": "float" },
      "clear": false,
      "blend": false,
      "depth": "preserve"
    },
    {
      "phase": "built-in/render_phase/geometry.render_phase",
      "shader": "built-in/shaders/lit_base",
      "iterator": "none",
      "uniforms": [],
      "target": { "name": "final", "shared": true },
      "clear": false,
      "blend": false,
      "depth": "preserve"
    },
    {
      "phase": "built-in/render_phase/light_shadow.render_phase",
      "shader": "built-in/shaders/shadow_depth",
      "iterator": "light",
      "uniformFactory": "built-in/uniform_factory/light_shadow_map.uniform_factory",
      "uniforms": [],
      "target": { "name": "shadow_gbuffer", "shared": true, "width": 2048, "height": 2048, "format": "float" },
      "clear": true,
      "blend": false,
      "depth": "clear"
    },
    {
      "phase": "built-in/render_phase/light_shadow.render_phase",
      "shader": "built-in/shaders/shadow_occlusion",
      "iterator": "light",
      "uniformFactory": "built-in/uniform_factory/light_shadow_occlusion.uniform_factory",
      "uniforms": [
        {
          "name": "_shadowDepthTex",
          "type": "renderTarget",
          "value": { "name": "shadow_gbuffer", "shared": true }
        }
      ],
      "target": { "name": "light_occlusion", "shared": true, "format": "float" },
      "depthSource": { "name": "scene_depth", "shared": true, "grouped": false },
      "clear": false,
      "blend": {
        "enabled": true,
        "op": "add",
        "src": "one",
        "dst": "one"
      },
      "depth": "preserve"
    },
    {
      "phase": "built-in/render_phase/lighting.render_phase",
      "shader": "built-in/shaders/lit",
      "iterator": "light",
      "uniformFactory": "built-in/uniform_factory/light_pass.uniform_factory",
      "uniforms": [
        {
          "name": "_lightOcclusionTex",
          "type": "renderTarget",
          "value": { "name": "light_occlusion", "shared": true }
        }
      ],
      "target": { "name": "final", "shared": true },
      "clear": false,
      "blend": {
        "enabled": true,
        "op": "add",
        "src": "one",
        "dst": "one"
      },
      "depth": "preserve"
    }
  ]
}
