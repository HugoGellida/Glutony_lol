{
    "configurations": [
        {
            "name": "Linux",
            "configurationProvider": "ms-vscode.cmake-tools",
            "compileCommands": "${workspaceFolder}/TP1_code/build/compile_commands.json",
            "includePath": [
                "${workspaceFolder}/TP1_code/**",
                "${workspaceFolder}/TP1_code/external/glfw-3.1.2/include",
                "${workspaceFolder}/TP1_code/external/glm-0.9.7.1",
                "${workspaceFolder}/TP1_code/external/glew-1.13.0/include",
                "${workspaceFolder}/TP1_code/external/stb_image",
                "${workspaceFolder}/TP1_code/external/RmlUi/Include",
                "${workspaceFolder}/TP1_code/external/RmlUi/Backends",
                "${workspaceFolder}/TP1_code/build/external/glfw-3.1.2/src",
                "${workspaceFolder}/TP1_code/build/**"
            ],
            "browse": {
                "path": [
                    "${workspaceFolder}/TP1_code",
                    "${workspaceFolder}/TP1_code/external/glfw-3.1.2/include",
                    "${workspaceFolder}/TP1_code/external/glm-0.9.7.1",
                    "${workspaceFolder}/TP1_code/external/glew-1.13.0/include",
                    "${workspaceFolder}/TP1_code/external/stb_image",
                    "${workspaceFolder}/TP1_code/external/RmlUi/Include",
                    "${workspaceFolder}/TP1_code/external/RmlUi/Backends",
                    "${workspaceFolder}/TP1_code/build/external/glfw-3.1.2/src"
                ],
                "limitSymbolsToIncludedHeaders": true
            },
            "defines": [],
            "compilerPath": "/usr/bin/g++",
            "cStandard": "c17",
            "cppStandard": "gnu++17",
            "intelliSenseMode": "linux-gcc-x64"
        }
    ],
    "version": 4
}